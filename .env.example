PORT=8080
APP_ENV=development

DATABASE_URL=postgres://legal_bench:legal_bench_dev_password@localhost:5432/legal_bench?sslmode=disable

STATIC_DIR=../legal-bench/dist

# Replace these once your domains and hosting are set up.
API_BASE_URL=https://api.example.com
FRONTEND_URL=https://legal-bench.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://legal-bench.example.com
SESSION_COOKIE_SECURE=false

# Optional one-time local bootstrap for the first platform admin.
# Remove these after the first admin is created.
BOOTSTRAP_PLATFORM_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=change-this-strong-password
BOOTSTRAP_PLATFORM_ADMIN_NAME=Platform Admin

# Optional SMTP settings for invitation emails. Local dev logs/returns links when unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# Private resume object storage. Use local for development; use s3 for production.
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_LOCAL_DIR=data/private-objects
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=true
